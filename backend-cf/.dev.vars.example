# Copy to .dev.vars for local Worker development. Never commit values.
# Names only: add values in the ignored .dev.vars file.
JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_STREAM_TOKEN=

VERYFI_CLIENT_ID=
VERYFI_CLIENT_SECRET=
VERYFI_USERNAME=
VERYFI_API_KEY=
AURA_PROOF_VERIFIER_PRIVATE_KEY_PKCS8_BASE64=
AURA_PROOF_NULLIFIER_KEY_BASE64=

# Comma/newline-separated HTTPS origins of up to three Rust aura-mobile-gateway instances.
# AURA_MOBILE_GATEWAY_URL remains a backward-compatible single-origin fallback.
AURA_MOBILE_GATEWAY_URLS=
AURA_MOBILE_GATEWAY_URL=
AURA_MOBILE_GATEWAY_TOKEN=

# Optional local integrations.
MAPBOX_ACCESS_TOKEN=
RESEND_API_KEY=
