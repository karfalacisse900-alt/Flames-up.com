# Cloudflare Worker server-only placeholders. Do not paste real secrets into git.
JWT_SECRET=replace-with-strong-secret
FRONTEND_URL=https://flames-up.com
ENVIRONMENT=development

# Ownership anchoring is disabled by default. These are future placeholders only.
OWNERSHIP_ANCHOR_PROVIDER=local
EVM_RPC_URL=
EVM_CONTRACT_ADDRESS=
SOLANA_RPC_URL=
IPFS_API_URL=
ARWEAVE_GATEWAY=

# Existing integrations, placeholders only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
CLOUDFLARE_STREAM_TOKEN=
POST_ASSIST_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GIPHY_API_KEY=

# Recorded voice. OPENAI_API_KEY is server-only; never expose it to the iOS or admin clients.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_MODERATION_MODEL=omni-moderation-latest
# Optional second-stage structured review model. Flagged results still require a human during rollout.
OPENAI_CONTEXT_REVIEW_MODEL=
CAPTRO_VOICE_POLICY_VERSION=captro-voice-v1
CAPTRO_VOICE_DISCLOSURE_VERSION=voice-ai-processing-v1
CAPTRO_VOICE_AUTO_REJECT=false
VOICE_MAX_POST_SECONDS=60
VOICE_MAX_REPLY_SECONDS=30
VOICE_MAX_BYTES=12582912
