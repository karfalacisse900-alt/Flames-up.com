# Cloudflare Worker server-only placeholders. Do not paste real secrets into git.
JWT_SECRET=replace-with-strong-secret
FRONTEND_URL=https://flames-up.com
ENVIRONMENT=development

# Ownership anchoring is disabled by default. These are future placeholders only.
OWNERSHIP_ANCHOR_PROVIDER=local
EVM_RPC_URL=
EVM_CONTRACT_ADDRESS=
SOLANA_RPC_URL=
IPFS_API_URL=
ARWEAVE_GATEWAY=

# Existing integrations, placeholders only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
CLOUDFLARE_STREAM_TOKEN=
POST_ASSIST_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Seller Identity is optional in addition to Connect KYC. Set only in an
# isolated Stripe test environment until its cost, consent, and policy are approved.
CAPTRO_SELLER_IDENTITY_MODE=connect
CAPTRO_IDENTITY_REQUIRE_SELFIE=false
# The installed StripeIdentity native sheet is invitation-only. Leave false
# unless Stripe has enabled native capture for this platform account.
CAPTRO_IDENTITY_NATIVE_ENABLED=false
CAPTRO_REQUIRE_MANUAL_PAYOUTS=false
GIPHY_API_KEY=

# Recorded voice. OPENAI_API_KEY is server-only; never expose it to the iOS or admin clients.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_MODERATION_MODEL=omni-moderation-latest
# Optional second-stage structured review model. Flagged results still require a human during rollout.
OPENAI_CONTEXT_REVIEW_MODEL=
CAPTRO_VOICE_POLICY_VERSION=captro-voice-v1
CAPTRO_VOICE_DISCLOSURE_VERSION=voice-ai-processing-v1
CAPTRO_VOICE_AUTO_REJECT=false
VOICE_MAX_POST_SECONDS=60
VOICE_MAX_REPLY_SECONDS=30
VOICE_MAX_BYTES=12582912

# Separate charges/transfers. Use a matching sandbox pair locally; secrets stay server-side.
STRIPE_MODE=test
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
# At least 32 cryptographically random characters; preserve across deployments.
CAPTRO_TICKET_SIGNING_SECRET=
# Development-stage safe traces. Leave false outside a time-limited investigation.
CAPTRO_PAYMENT_DIAGNOSTICS=false
# Optional: only when the iOS entitlement/provisioning profile matches this merchant.
CAPTRO_APPLE_PAY_MERCHANT_ID=
# Required operational settings: platform payout schedule manual; reviewed service
# completion/clearing; eligible seller account manual before a deferred transfer.
# These are verified against Stripe, not enabled by pretending an env flag is approval.
